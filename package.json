{
  "name": "reposhot",
  "version": "1.1.0",
  "description": "CLI that packs a local repository into a single XML file for AI consumption",
  "main": "dist/index.js",
  "bin": {
    "reposhot": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/gitignore.test.js .test-dist/test/walker.test.js .test-dist/test/xmlGenerator.test.js .test-dist/test/packer.test.js .test-dist/test/args.test.js .test-dist/test/reporter.test.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "keywords": ["cli", "ai", "xml", "repository"],
  "license": "MIT",
  "dependencies": {
    "minimatch": "^10.0.0",
    "tiktoken": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
